# Public storefront configuration
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_DEFAULT_REGION=il
NEXT_PUBLIC_BASE_URL=http://localhost:8000
# Optional server-to-server backend URL; browser requests use the public URL above.
MEDUSA_BACKEND_URL=
NEXT_PUBLIC_STORE_SEARCH_DEBOUNCE_MS=350
NEXT_PUBLIC_STRIPE_KEY=

# Public base URL of the image storage bucket, without a trailing slash
IMAGE_STORAGE_URL=https://PROJECT_REF.supabase.co/storage/v1/object/public/BUCKET_NAME

# Optional Medusa Cloud image storage configuration
MEDUSA_CLOUD_S3_HOSTNAME=
MEDUSA_CLOUD_S3_PATHNAME=

NODE_ENV=development

# Optional direct contact delivery; leave blank to use /store/contact on the backend.
# Configure these on the storefront service,
# even when Resend is already configured on the backend. Never use NEXT_PUBLIC_.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_FORM_TO_EMAIL=
# Optional alternative: when set, the webhook takes precedence over Resend.
CONTACT_FORM_WEBHOOK_URL=

# Exact public file supplied by Nedarim's Apple Pay domain registration screen.
# Configure on the STOREFRONT server. It is served without a redirect at /.well-known/...
NEDARIM_APPLE_PAY_DOMAIN_ASSOCIATION=
# Local preview only; the backend independently enforces its payment pause.
NEXT_PUBLIC_NEDARIM_CHECKOUT_PAUSED=false

# Optional server-side performance diagnostics (disabled by default).
PERF_DIAGNOSTICS_ENABLED=false
PERF_DIAGNOSTICS_SAMPLE_RATE=0.01
PERF_DIAGNOSTICS_MAX_TRACES_PER_MINUTE=10
PERF_DIAGNOSTICS_MAX_EVENTS_PER_TRACE=100
PERF_DIAGNOSTICS_MAX_BYTES_PER_TRACE=65536
PERF_DIAGNOSTICS_MAX_LOGS_PER_MINUTE=200
