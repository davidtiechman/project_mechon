# Public storefront configuration
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_DEFAULT_REGION=il
NEXT_PUBLIC_BASE_URL=http://localhost:8000
NEXT_PUBLIC_STORE_SEARCH_DEBOUNCE_MS=1000
NEXT_PUBLIC_STRIPE_KEY=

# Public base URL of the image storage bucket, without a trailing slash
IMAGE_STORAGE_URL=https://PROJECT_REF.supabase.co/storage/v1/object/public/BUCKET_NAME

# Optional Medusa Cloud image storage configuration
MEDUSA_CLOUD_S3_HOSTNAME=
MEDUSA_CLOUD_S3_PATHNAME=

NODE_ENV=development

# Optional direct contact delivery; leave blank to use /store/contact on the backend.
# Configure these on the storefront service,
# even when Resend is already configured on the backend. Never use NEXT_PUBLIC_.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_FORM_TO_EMAIL=
# Optional alternative: when set, the webhook takes precedence over Resend.
CONTACT_FORM_WEBHOOK_URL=
